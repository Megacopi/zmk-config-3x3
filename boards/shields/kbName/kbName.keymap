#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {  
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = < &kp K_CUT    &kp K_COPY    &kp K_PASTE    
                         &kp PAGE_UP    &kp UP    &kp PAGE_DOWN
                         &kp LEFT    &kp DOWN    &kp RIGHT >;
        };
    };
 };
