#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "GRUB";
            bindings = 
                &none      &kp UP     &none
                &none      &kp ENTER  &none
                &none      &kp DOWN   &none
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = 
                &trans       &sys_reset   &bootloader
                &bt BT_SEL 0 &bt BT_SEL 1 &out OUT_TOG
                &bt BT_CLR   &kp N0       &kp DOT
            >;
        };
    };
};